# Spar with a Friend / DebateBot — local-first LLM

# PRIMARY: local Ollama (no API key required)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# On ~4GB RAM machines you can try: OLLAMA_MODEL=llama3.2:1b
# Pull: ollama pull llama3.2:3b

# OPTIONAL cloud fallback (never required for the demo)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_api_key_here
# LLM_MODEL=llama-3.3-70b-versatile

# Optional: API Configuration
# API_HOST=127.0.0.1
# API_PORT=8000

# Optional: CORS Configuration
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
